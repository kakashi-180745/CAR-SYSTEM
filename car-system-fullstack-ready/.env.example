# ==========================================
# CAR SYSTEM - ENVIRONMENT VARIABLES EXAMPLE
# Copy values into your shell/service config
# ==========================================

# Backend Server
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# MySQL Database (Create a dedicated user in production, do not use root)
DB_URL=jdbc:mysql://localhost:3306/car_ecommerce?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=car_app_user
DB_PASSWORD=replace_with_strong_db_password
JPA_DDL_AUTO=validate

# JWT Security (Required in production: 32+ random characters)
JWT_SECRET=replace_with_a_strong_random_256_bit_jwt_secret_key
JWT_EXPIRATION_MS=86400000

# CORS (Comma-separated allowed origins/patterns)
CORS_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Initial Administrator Bootstrap (Optional)
BOOTSTRAP_ADMIN_EMAIL=admin@carsystem.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_admin_password
BOOTSTRAP_ADMIN_NAME=System Admin

# Protected Admin Registration Code (Leave empty to disable /admin/signup)
ADMIN_SIGNUP_CODE=

# Profile Upload Directory
UPLOAD_DIR=uploads/profiles
